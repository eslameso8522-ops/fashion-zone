# ========================================================
# Fashion Zone - إعدادات البيئة والخدمات المجانية السحابية
# ========================================================

# 1. قاعدة بيانات MySQL المجانية (من منصة TiDB Cloud Serverless)
# يمكنك الحصول على الرابط مجاناً من https://tidbcloud.com
DATABASE_URL="mysql://root:your_password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/fashion_zone?ssl={\"rejectUnauthorized\":true}"

# 2. خدمة رفع الصور التلقائي المجانية (من منصة Cloudinary)
# يمكنك الحصول عليها مجاناً من لوحة تحكم https://cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# 3. إعدادات المتجر العامة
NEXT_PUBLIC_STORE_NAME="Fashion Zone"
NEXT_PUBLIC_STORE_URL="https://fashion-zone.vercel.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="201000000000" # رقم الواتساب لاستقبال الطلبات مع كود الدولة
