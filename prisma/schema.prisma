generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  image        String    @db.Text
  showInNavbar Boolean   @default(true)
  orderIndex   Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  nameEn        String?
  code          String?   // Product model/catalog code e.g. "3606", "5314"
  description   String    @db.Text
  price         Float
  costPrice     Float?    // Cost / purchase price from factory or supplier
  originalPrice Float?
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images        Json      // Array of image URLs
  sizes         Json?     // Array of sizes e.g. ["S", "M", "L"]
  colors        Json?     // Array of color objects [{ name: "وردي", hex: "#fecdd3" }]
  reviews       Json?     // Array of review objects [{ name, rating, comment, date, verified }]
  isFeatured    Boolean   @default(false)
  isNewArrival  Boolean   @default(false)
  inStock       Boolean   @default(true)
  rating        Float     @default(5.0)
  reviewsCount  Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  customerName    String
  customerPhone   String
  customerAddress String   @db.Text
  items           Json     // Ordered items snapshot
  total           Float
  discountAmount  Float    @default(0)
  couponCode      String?
  status          String   @default("PENDING") // PENDING, PREPARING, SHIPPED, DELIVERED, CANCELLED
  trackingNumber  String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique // e.g. "GIRL10", "WELCOME20"
  description    String?   // e.g. "خصم 10% بمناسبة الافتتاح"
  discountType   String    @default("PERCENTAGE") // "PERCENTAGE" or "FIXED"
  discountValue  Float     // e.g. 10 (for 10%) or 50 (for 50 EGP)
  minOrderAmount Float     @default(0)
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   @db.Text
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id                  String   @id @default("default")
  storeName           String   @default("Fashion Zone")
  whatsappNumber      String   @default("201000000000")
  facebookUrl         String   @default("https://facebook.com")
  instagramUrl        String   @default("https://instagram.com")
  tiktokUrl           String   @default("https://tiktok.com")
  announcementText    String   @default("تألقي مع تشكيلة Fashion Zone الجديدة ✨ شحن مجاني للطلبات فوق 500 جنيه | كود خصم: GIRL10")
  announcementEnabled Boolean  @default(true)
  
  // Professional Ads & Promo Popups Control
  promoPopupTitle     String?  @default("عرض خاص وحصري لكِ يا جميلة ✨")
  promoPopupText      String?  @db.Text
  promoPopupImage     String?  @db.Text
  promoCouponCode     String?  @default("GIRL10")
  promoPopupEnabled   Boolean  @default(true)
  
  // Hero & Homepage Promos
  heroBannerTitle     String?  @default("خصم يصل إلى 35% على تشكيلة فساتين السهرة الفاخرة!")
  heroBannerSubtitle  String?  @default("استمتعي بأفضل الأسعار مع خامات مستوردة أصلية 100% وشحن مجاني حتى باب منزلك مع إمكانية المعاينة.")
  heroBannerBadge     String?  @default("عرض محدود لفترة وجيزة")
  heroBannerCtaText   String?  @default("تصفحي العروض الآن")
  heroBannerCtaLink   String?  @default("#catalog")
  heroBannerImage     String?  @db.Text
  heroBannerEnabled   Boolean  @default(true)

  // Hero Section Dynamic Controls
  heroTitle           String?  @default("كوني الأجمل في كل إطلالة مع Fashion Zone")
  heroSubtitle        String?  @default("اكتشفي تشكيلة راقية ومختارة بعناية من فساتين السهرة الناعمة، العبايات المطرزة، الحقائب والمجوهرات التي تزيدكِ تألقاً وسحراً.")
  heroImage           String?  @db.Text
  heroBadgeText       String?  @default("أعلى تقييم ⭐ 4.9")
  heroBadgeSubtext    String?  @default("أزياء صيف 2026")
  heroCouponTitle     String?  @default("كود الخصم الفوري")
  heroCouponCode      String?  @default("GIRL10")
  heroCouponDiscount  String?  @default("خصم 10%")
  heroCouponEnabled   Boolean  @default(true)
  heroBadgeEnabled    Boolean  @default(true)
  heroProductId       String?  // Optional linked product id from the store
  heroCtaText         String?  @default("تسوقي الآن / Shop Now")
  heroCtaLink         String?  @default("#catalog")

  // Watermark & Brand Protection
  watermarkEnabled    Boolean  @default(true)
  watermarkPosition   String   @default("bottom-right")

  updatedAt           DateTime @updatedAt
}

model Expense {
  id        String   @id @default(cuid())
  title     String   // e.g. "إعلانات فيسبوك ممولة", "مصاريف شحن وتوصيل", "أكياس وبوليصات"
  category  String   // "MARKETING", "SHIPPING", "PACKAGING", "SALARIES", "INVENTORY", "OTHER"
  amount    Float
  date      DateTime @default(now())
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
